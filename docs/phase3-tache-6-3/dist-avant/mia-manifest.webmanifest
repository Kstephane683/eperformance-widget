{
  "id": "./index.html",
  "name": "Mia — assistante ePerformance",
  "short_name": "Mia",
  "description": "Posez votre question à Mia, l'assistante IA d'ePerformance : trouver des clients, gagner en visibilité, automatiser votre activité.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html?app=1",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#fdfcfa",
  "background_color": "#fdfcfa",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "./icons/mia-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/mia-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/mia-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/mia-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./preuves/mia-application-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "./preuves/mia-application-ordinateur.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Poser une question",
      "short_name": "Question",
