      "icons": [{ "src": "./icons/mia-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mes conversations",
      "short_name": "Conversations",
      "description": "Reprendre une conversation commencée",
      "url": "./index.html?app=1#/messages",
      "icons": [{ "src": "./icons/mia-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Ce que Mia sait faire",
      "short_name": "Aide",
